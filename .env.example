# Copy this file to .env.local and fill in values from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Your live address, e.g. https://albashirautos.com (sitemap, canonical, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database connection for "npm run db:push" (runs the SQL files). Secret: never share or commit.
# Supabase > Connect > Session pooler > URI, with your database password filled in.
SUPABASE_DB_URL=

# Secret server key for Admin > Team. Supabase > Project Settings > API keys > service_role. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
